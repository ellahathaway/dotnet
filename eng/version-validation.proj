<Project Sdk="Microsoft.Build.Traversal">

    <PropertyGroup>
      <TargetFramework>$(NetCurrent)</TargetFramework>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="$(TasksDir)Microsoft.DotNet.UnifiedBuild.Tasks\Microsoft.DotNet.UnifiedBuild.Tasks.csproj" />
    </ItemGroup>

    <Target Name="SetupDarc"
            DependsOnTargets="ResolveProjectReferences"
            BeforeTargets="Build">

      <PropertyGroup>
        <!-- Path to the darc executable -->
        <DarcTool Condition="$(BuildOS) == 'windows'">darc.exe</DarcTool>
        <DarcTool Condition="$(BuildOS) != 'windows'">darc</DarcTool>
        <DarcDefaultPath>$(ArtifactsDir)tmp/Debug/darc/$(DarcTool)</DarcDefaultPath>
        <DarcPath Condition="'$(DarcPath)' == ''">$(DarcDefaultPath)</DarcPath>

        <!-- Command to setup darc -->
        <DarcSetUpCommand Condition="$(BuildOS) == 'Windows_NT'">cmd /c ".\eng\common\tools.sh &amp;&amp; Get-Darc"</DarcSetUpCommand>
        <DarcSetUpCommand Condition="$(BuildOS) != 'Windows_NT'">bash -c '. eng/common/tools.sh &amp;&amp; GetDarc'</DarcSetUpCommand>
      </PropertyGroup>

      <Exec Command="$(DarcSetUpCommand)"
            Condition="!Exists('$(DarcPath)') and '$(DarcPath)' == '$(DarcDefaultPath)'"
            WorkingDirectory="$(DotNetRootDirectory)" />
    </Target>

    <UsingTask TaskName="Microsoft.DotNet.UnifiedBuild.Tasks.VersionValidation" AssemblyFile="$(MicrosoftDotNetUnifiedBuildTasksAssembly)" TaskFactory="TaskHostFactory" />
    <Target Name="VersionValidation"
            DependsOnTargets="ResolveProjectReferences;SetupDarc"
            BeforeTargets="Build">
      <Error Condition="'$(DotNetRootDirectory)' == ''" Text="DotNetRootDirectory is not set." />
      <Error Condition="'$(DarcPath)' == ''" Text="DarcPath is not set." />
      <Error Condition="'$(PullRequestTargetBranch)' == ''" Text="PullRequestTargetBranch is not set." />
      <Error Condition="'$(PullRequestTitle)' == ''" Text="PullRequestTitle is not set." />

      <Microsoft.DotNet.UnifiedBuild.Tasks.VersionValidation
        DotNetRootDirectory="$(DotNetRootDirectory)"
        DarcPath="$(DarcPath)"
        PullRequestTargetBranch="$(PullRequestTargetBranch)"
        PullRequestTitle="$(PullRequestTitle)" />
    </Target>

  </Project>
