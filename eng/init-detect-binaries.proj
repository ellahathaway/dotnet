<Project Sdk="Microsoft.Build.NoTargets">

  <PropertyGroup>
    <TargetFramework>$(NetCurrent)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(ToolsDir)BinaryToolKit\BinaryToolKit.csproj" />
  </ItemGroup>

  <UsingTask TaskName="BinaryToolTask" AssemblyFile="$(BinaryToolKitAssembly)" TaskFactory="TaskHostFactory" />

  <PropertyGroup>
    <BinariesMode Condition="'$(BinariesMode)' == ''">Validate</BinariesMode>
    <AllowedBinariesFile Condition="'$(AllowedBinariesFile)' == ''">$(RepositoryEngineeringDir)allowed-vmr-binaries.txt</AllowedBinariesFile>
  </PropertyGroup>

  <Target Name="DetectBinaries"
          DependsOnTargets="ResolveProjectReferences"
          BeforeTargets="Build">

    <BinaryToolTask
      Mode="$(BinariesMode)"
      TargetDirectory="$(RepoRoot)"
      AllowedBinariesFile="$(AllowedBinariesFile)"
      OutputReportDirectory="$(BinariesReportDir)" />
  </Target>

  <Target Name="CreateBaselineUpdatePR"
          DependsOnTargets="DetectBinaries"
          Condition="'$(CreateBinariesBaselineUpdatePR)' == 'true'">

    <ItemGroup>
      <PackageReference Include="Microsoft.DotNet.Baselines.Tasks" Version="$(MicrosoftDotNetBaselinesTasksVersion)" />
    </ItemGroup>

    <PropertyGroup>
      <BinariesBaselineUpdatePRTitle>Update VMR Binaries Baselines</BinariesBaselineUpdatePRTitle>
    </PropertyGroup>

    <CreateUpdatePR
      Repo="$(BaselineUpdatePRRepo)"
      Branch="$(BaselineUpdatePRTargetBranch)"
      OriginalFilesDirectory="$(RepositoryEngineeringDir)"
      UpdatedFilesDirectory="$(BinariesReportDir)"
      Title="$(BinariesBaselineUpdatePRTitle)"
      BuildId="$(BuildId)" />
  </Target>

</Project>
